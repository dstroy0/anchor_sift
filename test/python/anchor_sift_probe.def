;
; The entries test/python/sift_test.py reads from the anchor_sift kernel built alone as a Windows DLL, with
; ANCHOR_SIFT_COUNT_READS=1 so the read counters exist. A shared object on Linux exports them without this file.
LIBRARY anchor_sift_host
EXPORTS
    anchor_sift_naive
    anchor_sift_inorder
    anchor_sift_free
    anchor_sift_run
    anchor_sift_choose
    anchor_sift_engine_name
    anchor_sift_anchors_for
    anchor_sift_counters_reset
    anchor_sift_probes DATA
    anchor_sift_verifications DATA
    anchor_field_census
    anchor_steer_magnitude
    anchor_steer_probe_order
    anchor_steer_prefers_free
    anchor_steer_count
    anchor_steer_count_with_probes
    anchor_steer_probe_fits
    anchor_steer_probes_reset
    anchor_steer_probes DATA

# Build trees and fetched data.
build/
build-*/

# The rendered site.
site/

# Cloned dependencies. 
/deps/

# The hand extractions and the papers they were read from. 
*.oracle.tsv

# Python caches. The tools here are run directly and cache next to themselves.
__pycache__/
*.pyc
*.pyo

# What a LaTeX run leaves beside the source when it is not given an output directory.
#
# maint/texbuild/build_theory.sh compiles with -output-directory and leaves none of this.
# main.pdf is included here on purpose.
*.aux
*.log
*.toc
*.lof
*.lot
*.out
*.synctex
*.synctex.gz
*.fls
*.fdb_latexmk
theory/*/main.pdf
theory/*/*/main.pdf
theory_bucket/*/main.pdf
theory_bucket/*/*/main.pdf

# What bench_raster drops where it is run from.
*.pgm
*.raw
*.raw.txt

# Editor and OS leavings.
.vscode/
.idea/
.DS_Store
Thumbs.db

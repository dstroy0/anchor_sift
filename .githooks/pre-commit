#
# Runs the docs check and the claim check before a commit is written, and builds every research
# paper the commit touches.
#
# This hook sits in the repository instead of .git/hooks. It is version controlled and everyone gets
# the same one. Turn it on once per clone:
#
#     git config core.hooksPath .githooks
#
# Breaking findings stop the commit: an empty table, an em dash, a link to a file that is not there,
# and markdown left in a .tex. Those render as a broken page and a reader sees them.
#
# Prose findings are a ratchet. utils/maint/prose/prose_ratchet.tsv holds the most prose findings each file
# may carry. A commit that raises a staged file above its number is stopped. A commit that lowers one
# writes the lower number into the ratchet and stages it with the commit. The backlog only shrinks.
# Only staged files are held to it: the rest of the working tree is somebody else's work in
# progress.
#
# The markdown case is read off the rendered page and not off the source. A --- typesets as an em
# dash. A check looking for the character alone misses the one definition a converter produces, and
# asterisks and escaped underscores reach the page as themselves. None of them is a LaTeX error:
# the research paper builds clean and carries them to the archive.
#
# To see everything and fail on all of it:  python utils/maint/prose/docs_check --strict
# To rewrite the ratchet after a file moves: python utils/maint/prose/docs_check --ratchet-write=utils/maint/prose/prose_ratchet.tsv
# To commit past it once:                   git commit --no-verify
#
# WHAT TO ASK IT WHILE REPAIRING. The checker answers more than pass or fail, and these are the
# readings a repair wants. No hook calls these. The first seven write nothing on disk; --sample
# writes build/gate/sample.txt and --harmonics rewrites the voice band tables beside voice.tsv.
#
#   python utils/maint/prose/docs_check --pick=after <word>        what this writing puts after a word
#   python utils/maint/prose/docs_check --pick=between <one> <two> what it puts between two
#   python utils/maint/prose/docs_check --pick=rank <word> ...     each word's count, 0 where unused
#   python utils/maint/prose/docs_check --offlist                  words voice.tsv does not approve
#   python utils/maint/prose/docs_check --show=<regex>             the lines those findings sit on
#   python utils/maint/prose/docs_check --slack                    ratchet ceilings nothing reaches
#   python utils/maint/prose/docs_check --holes=<diff>             sentences a repair may have broken
#   python utils/maint/prose/docs_check --rate [<root> ...]        banned shapes as a rate per 100k words
#   python utils/maint/prose/docs_check --plain <path> ...         the prose with the mathematics taken out
#   python utils/maint/prose/docs_check --sample --words N <root>  one continuous sample, with a manifest
#   python utils/maint/prose/docs_check --harmonics                the voice as a rhythm spectrum
#
# WHY THIS RESOLVES ITS OWN PATHS
#
# Every path here is built from the tree git names as the toplevel, not from where this script sits.
# Testing for a docs directory in the working directory and exiting 0 where there is none, or naming
# the checker by a literal path, are the two faults this avoids, and both pass silently: a hook that
# cannot find the tool and a hook that cannot find the files both let the commit through while
# looking like they ran.

set -u

# The tree being committed, and not the tree this script happens to sit in. core.hooksPath is an
# absolute path into the main checkout. "$0" is always main's copy of this file, however many
# linked worktrees exist. Resolving from "$0" gates a linked worktree's commit on main's WORKING
# TREE, which holds whatever is half written there at that moment, instead of on what is being
# committed. --show-toplevel is correct for the main worktree and for a linked one alike.
REPO=$(git rev-parse --show-toplevel 2>/dev/null)

if [ -z "$REPO" ]; then
    echo "  commit stopped: git could not name a working tree to check."
    exit 1
fi

# The tools directory is named once, in repotools.toml, and asked for by kind and not by
# directory. Hardcoding utils/maint/ here makes a tools move a hook edit instead of a config line, and a
# hook that is edited by hand during a move is a hook that gets it wrong. A missing key stops the
# commit instead of falling back to a guess. A guessed path can name a directory that no longer
# holds the tools, and every check below would then be skipped.
TOOLS=$(sed -n 's/^[[:space:]]*tools[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$REPO/repotools.toml" 2>/dev/null | head -1)

if [ -z "$TOOLS" ]; then
    echo "  commit stopped: no [layout] tools key in $REPO/repotools.toml"
    echo "  the hook will not guess where the tools live."
    exit 1
fi

CHECK="$REPO/$TOOLS/prose/docs_check"

if [ ! -f "$CHECK/__main__.py" ]; then
    echo "  commit stopped: no docs check at $CHECK"
    echo "  the hook has the wrong path, or the checkout is incomplete."
    exit 1
fi

# No root argument. The checker uses its own roots, all inside this repository: docs, src, examples,
# maint, theory and test. Naming only docs here leaves the READMEs beside the code unchecked, and a README
# can carry a paragraph inside a table. The checker raises on a root that does not exist, the other
# half of the same fault: the checker reads only part of the tree and exits 0.
RATCHET="$REPO/$TOOLS/prose/prose_ratchet.tsv"
python "$CHECK" --staged --ratchet="$RATCHET"
status=$?

# A lowered ceiling is written by the checker and goes into this commit with the files that lowered
# it. Left unstaged, the next commit would carry it without the change that earned it.
if ! git -C "$REPO" diff --quiet -- "$RATCHET"; then
    git -C "$REPO" add -- "$RATCHET"
fi

# The claim check holds every number a reader meets first against the theory, and stops pages that
# repeat a result the theory took back. It runs when a path in the index is README.md, a page under
# docs/, a file under theory/ or the check itself, since no other path can change an answer. It
# reads the working tree and not the index. The full report is shown only when it fails.
CLAIMS="$REPO/$TOOLS/claims/claim_check.py"
claims=0
if git -C "$REPO" diff --cached --name-only | grep -qE "^(README\.md|docs/|theory/|$TOOLS/claims/)"; then
    if [ ! -f "$CLAIMS" ]; then
        echo "  commit stopped: no claim check at $CLAIMS"
        exit 1
    fi
    report=$(python "$CLAIMS")
    claims=$?
    if [ "$claims" -eq 0 ]; then
        echo "$report" | tail -1
    else
        echo "$report"
    fi
fi

# Every research paper a path in the index belongs to is built, and its PDF, named after its
# directory and kept beside its main.tex, goes into the same index. A paper is the nearest
# directory above the path that holds a main.tex. The PDF of the paper itself does not count as a
# change to the paper, and a figure that is a PDF does. Only the papers in the index are built, since a full
# build of every paper takes minutes. A paper that fails or drops a glyph stops the commit.
PAPERS=$(git -C "$REPO" diff --cached --name-only -- theory | while read -r path; do
    dir=$(dirname "$path")
    [ "$(basename "$path")" = "$(basename "$dir").pdf" ] && continue
    while [ "$dir" != "theory" ] && [ "$dir" != "." ]; do
        if [ -f "$REPO/$dir/main.tex" ]; then
            echo "${dir#theory/}"
            break
        fi
        dir=$(dirname "$dir")
    done
done | sort -u)
pdfs=0
if [ -n "$PAPERS" ]; then
    if sh "$REPO/$TOOLS/texbuild/build_theory.sh" $PAPERS; then
        for paper in $PAPERS; do
            git -C "$REPO" add -- "theory/$paper/$(basename "$paper").pdf"
        done
    else
        pdfs=1
    fi
fi

if [ "$status" -eq 0 ] && [ "$claims" -eq 0 ] && [ "$pdfs" -eq 0 ]; then
    exit 0
fi

echo ""
if [ "$status" -eq 0 ] && [ "$claims" -eq 0 ]; then
    echo "  commit stopped: a research paper did not build clean, see the lines above."
elif [ "$status" -eq 0 ]; then
    echo "  commit stopped: a page repeats a claim the theory took back. Read the places shown;"
    echo "  a finding read and found sound goes in $TOOLS/claims/claims_read.tsv with why."
elif [ "$status" -eq 2 ]; then
    # The checker returns this when it read no files at all. That is never a pass.
    echo "  commit stopped: the docs check read nothing. Nothing was checked."
elif [ "$status" -eq 3 ]; then
    echo "  commit stopped: a staged file carries more prose findings than its ratchet allows."
elif [ "$status" -eq 4 ]; then
    echo "  commit stopped: the prose ratchet at $RATCHET is missing."
else
    echo "  commit stopped: breaking finding(s) above."
fi
echo "  fix them, or commit with --no-verify if you know why"
exit 1

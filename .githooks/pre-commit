#
# Runs the docs check before a commit is written.
#
# It lives in the repository instead of .git/hooks so it is version controlled and everyone gets the
# same one. Turn it on once per clone:
#
#     git config core.hooksPath .githooks
#
# Breaking findings stop the commit: an empty table, an em dash, a link to a file that is not there,
# and markdown left in a .tex. Those render as a broken page and a reader sees them. Prose findings
# are printed and let through, because the prose backlog predates the check and a hook nobody can
# satisfy gets turned off.
#
# The markdown case was added after three of them were found by reading rendered pages instead. A
# --- typesets as an em dash. The check that had been looking for the character missed the one
# definition a converter produces; asterisks and escaped underscores reach the page as themselves.
# None of the three is a LaTeX error. The book builds clean and carries them to the archive.
#
# To see everything and fail on all of it:  python maint/prose/docs_check.py --strict
# To commit past it once:                   git commit --no-verify
#
# WHY THIS RESOLVES ITS OWN PATHS
#
# Every path here is built from the hook's own location. The first version tested for a docs
# directory in the working directory and exited 0 when it did not find one, and it named the checker
# by a path that later moved. Both faults pass silently: a hook that cannot find the tool and a hook
# that cannot find the files both let the commit through while looking like they ran.

set -u

# The tree being committed, and not the tree this script happens to sit in. core.hooksPath is an
# absolute path into the main checkout. "$0" is always main's copy of this file however many
# linked worktrees exist. Resolving from it gated every worktree commit on main's WORKING TREE
# instead of on what was being committed, and main's working tree is whatever the other sessions
# have half written at that moment. Two commits were stopped that way inside a few minutes, by two
# different files, neither belonging to the session being stopped. --show-toplevel is correct for
# the main worktree and for a linked one alike.
REPO=$(git rev-parse --show-toplevel 2>/dev/null)

if [ -z "$REPO" ]; then
    echo "  commit stopped: git could not name a working tree to check."
    exit 1
fi

# The tools directory is named once, in repotools.toml, and asked for by kind. Hardcoding maint/ here is what makes the tools move under objective 5 a hook edit
# instead of a config line, and a hook that is edited by hand during a move is a hook that gets it
# wrong. A missing key stops the commit.
TOOLS=$(sed -n 's/^[[:space:]]*tools[[:space:]]*=[[:space:]]*"\([^"]*\)".*/\1/p' \
    "$REPO/repotools.toml" 2>/dev/null | head -1)

if [ -z "$TOOLS" ]; then
    echo "  commit stopped: no [layout] tools key in $REPO/repotools.toml"
    echo "  the hook will not guess where the tools live."
    exit 1
fi

CHECK="$REPO/$TOOLS/prose/docs_check.py"

if [ ! -f "$CHECK" ]; then
    echo "  commit stopped: no docs check at $CHECK"
    echo "  the hook has the wrong path, or the checkout is incomplete."
    exit 1
fi

# No argument. The checker uses its own roots: docs, src, examples and maint. Naming only docs
# here once left twelve READMEs beside the code unchecked, and one of them was carrying a paragraph
# inside a table. The checker now raises on a root that does not exist, the other half of
# the same fault: it once read 188 files instead of 317 and exited 0.
python "$CHECK"
status=$?

# The citation registry, and it refuses. A name used in this tree with no row means the work rests
# on somebody's result and does not say whose, and that is the same class of defect the corpus
# manifest gate catches one domain over.
#
# It refuses two ways. A name with no row exits 1. The closed citations repository being absent
# exits 2, because the question cannot be asked at all without it, and a check that reads nothing
# is never a pass. The second one catches everybody outside this work. ANCHOR_SIFT_BYPASS=1
# carries the tool's own --bypass in and the commit goes through with the bypass printed.
CITATIONS="$REPO/$TOOLS/citations/citations.py"

# A missing tool stops the commit and is never skipped. This block used to guard with -f and do
# nothing when the file was absent. When maint/ was sorted into categories and citations.py moved
# one directory down, the gate turned itself off and every commit passed without it. Nothing said
# so. That is the fault this hook's own header was written about, reintroduced by a move.
if [ ! -f "$CITATIONS" ]; then
    echo "  commit stopped: no citation gate at $CITATIONS"
    echo "  the hook has the wrong path, or the checkout is incomplete."
    exit 1
fi

# Held in a variable and not a file. A hook writes nothing beside the source, and build/ is
# not there on a fresh clone.
said=$(python "$CITATIONS" --check 2>&1)
citations=$?
if [ "$citations" -ne 0 ]; then
    echo "$said"
    echo ""
    echo "  commit stopped: the citation gate was not answered."
    exit 1
fi

if [ "$status" -eq 0 ]; then
    exit 0
fi

echo ""
if [ "$status" -eq 2 ]; then
    # The checker returns this when it read no files at all. That is never a pass.
    echo "  commit stopped: the docs check read nothing. Nothing was checked."
else
    echo "  commit stopped: breaking finding(s) above."
fi
echo "  fix them, or commit with --no-verify if you know why"
exit 1

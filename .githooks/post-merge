#
# Brings theory/ to the commit this tree records for it, after a pull.
#
# It lives in the repository instead of .git/hooks so it is version controlled and everyone gets the
# same one. Turn it on once per clone:
#
#     git config core.hooksPath .githooks
#
# theory/ is the public repository https://github.com/dstroy0/theory, held here as a git submodule.
# The books are written there: an edit is committed and pushed in theory/ first, and this tree then
# commits the new submodule commit. A pull that moves the recorded commit leaves theory/ checked out
# at the old one until `git submodule update` runs, and this hook runs it.
#
# The subtree design this file held until 2026-09-26 is gone. theory_bucket, a private repository,
# was renamed dstroy0/theory and made public, and it reaches this tree only as the submodule.
#
# WHY IT SOMETIMES REFUSES
#
# `git submodule update` checks theory/ out at a detached commit. Uncommitted work in theory/ would be
# lost or stop the checkout halfway, and a local commit there that the recorded one does not hold
# would be left behind on no branch. In either case the hook says what it found and does nothing.
#
# ANCHOR_SIFT_NO_THEORY_UPDATE=1 turns it off.

set -u

if [ "${ANCHOR_SIFT_NO_THEORY_UPDATE:-0}" = "1" ]; then
    exit 0
fi

REPO=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$REPO" || exit 0

# A clone that has not initialized the submodule is not an error. It reads the books with
# `git submodule update --init theory` when it wants them.
if [ ! -e theory/.git ]; then
    exit 0
fi

recorded=$(git rev-parse --verify --quiet "HEAD:theory" 2>/dev/null)
current=$(git -C theory rev-parse --verify --quiet HEAD 2>/dev/null)
if [ -z "$recorded" ] || [ -z "$current" ]; then
    echo "  theory not updated: could not read the recorded and checked-out commits"
    exit 0
fi
if [ "$recorded" = "$current" ]; then
    exit 0
fi

if [ -n "$(git -C theory status --porcelain 2>/dev/null)" ]; then
    echo "  theory not updated: theory/ has uncommitted changes"
    echo "  when you are ready:  git submodule update theory"
    exit 0
fi

# The checked-out commit must already be in the recorded one's history, or a local commit in theory/
# would be left on no branch.
if ! git -C theory merge-base --is-ancestor "$current" "$recorded" 2>/dev/null; then
    echo "  theory not updated: theory/ is at $current, which $recorded does not contain"
    echo "  push or rebase it in theory/, then:  git submodule update theory"
    exit 0
fi

if git submodule update theory; then
    echo "  theory updated to $recorded"
else
    echo "  theory not updated: git submodule update failed, see above"
fi
exit 0

krs 1
# VHDL-2008, a language of the register lane (emit_lane.h), which GHDL analyzes and runs. The format is the comment at
# the head of ptx.krs. The lane is a procedure in the package cycle_program: its registers are variables, a word
# unsigned(31 downto 0) and a wide word unsigned(63 downto 0), its predicates booleans, and its carry a variable the
# chains set and read, as PTX's carry flag is set and read. Memory is one array of words the lane reads and writes by
# byte address, the launch laid in it as the device lays CycleCompiledLaunch. The text holds its own conversions
# (word_of, wide_of, signed_of) and its own memory reads and writes, so the file needs no package but ieee's. A word's
# value is the bank immediate, a 32-bit literal; a count, an offset or a shift is a VHDL integer. The text is the lane
# in the language alone: the circuit a part can clock is a filter applied after it.
ruleset vhdl
toolchain ghdl
header lane_open

# the lane's registers
bank file = v({n})
bank sign = g({n})
bank out = o({n})
bank atom = a({n})
bank temporary = t({n})
bank wide = w({n})
bank predicate = p({n})
bank member = member({n})
# a word's value written into a form, a 32-bit literal: VHDL's integer holds only +-(2^31 - 1), and a word is a
# vector of its own width
bank immediate = unsigned'(32D"{n}")
fixed zero = zero
fixed lane_number = lane_number
fixed record = record_address
fixed index = index_address
fixed body = body_number
fixed bodies = bodies
fixed tables = tables
fixed threads = threads
fixed word_base = word_base
fixed word_stride = word_stride
fixed sign_base = sign_base
fixed indexed = indexed
fixed one = one
fixed good = good

# the program's text around the lane
form program_note steps major minor compiler_major compiler_minor block = -- a record program of {steps} steps, as VHDL-2008\n
form shared_extern = -- the lane calls the operator block, which is not written in VHDL yet\n
form callee_declare_answered function = -- the operator block's {function}\n
form callee_declare function = -- the operator block's {function}\n
form callee_parameter function at =
form callee_parameter_last function at =
form callee_close =
form lane_open = \nlibrary ieee;\nuse ieee.std_logic_1164.all;\nuse ieee.numeric_std.all;\n\npackage cycle_program is\n    subtype cycle_word is unsigned(31 downto 0);\n    subtype cycle_wide is unsigned(63 downto 0);\n    type cycle_memory is array (natural range <>) of cycle_word;\n    type cycle_words is array (natural range <>) of cycle_word;\n    type cycle_wides is array (natural range <>) of cycle_wide;\n    type cycle_predicates is array (natural range <>) of boolean;\n\n    procedure cycle_lane(variable memory : inout cycle_memory; constant launch_given : in cycle_wide;\n                         constant lane_given : in cycle_wide);\nend package cycle_program;\n\npackage body cycle_program is\n\n    function word_of(value : integer) return cycle_word is\n    begin\n        return unsigned(to_signed(value, 32));\n    end function word_of;\n\n    function word_of(value : unsigned) return cycle_word is\n    begin\n        return resize(value, 32);\n    end function word_of;\n\n    function wide_of(value : integer) return cycle_wide is\n    begin\n        return unsigned(to_signed(value, 64));\n    end function wide_of;\n\n    function wide_of(value : unsigned) return cycle_wide is\n    begin\n        return resize(value, 64);\n    end function wide_of;\n\n    function signed_of(value : cycle_word) return integer is\n    begin\n        return to_integer(signed(value));\n    end function signed_of;\n\n    function word_at(memory : cycle_memory; address : cycle_wide) return cycle_word is\n    begin\n        return memory(to_integer(address(62 downto 2)));\n    end function word_at;\n\n    function wide_at(memory : cycle_memory; address : cycle_wide) return cycle_wide is\n    begin\n        return word_at(memory, address + 4) & word_at(memory, address);\n    end function wide_at;\n\n    procedure put_word(variable memory : inout cycle_memory; constant address : in cycle_wide;\n                       constant value : in cycle_word) is\n    begin\n        memory(to_integer(address(62 downto 2))) := value;\n    end procedure put_word;\n\n    procedure cycle_lane(variable memory : inout cycle_memory; constant launch_given : in cycle_wide;\n                         constant lane_given : in cycle_wide) is\n        variable refusal : integer;\n        variable carry : natural;\n        variable total : unsigned(32 downto 0);\n        variable product : unsigned(63 downto 0);\n
form lane_body =     begin\n        refusal := -2;\n        carry := 0;\n        flow : loop\n
form lane_close =         end if;\n    end procedure cycle_lane;\n\nend package body cycle_program;\n

# the lane's declarations
form declare_predicates count =         variable p : cycle_predicates(0 to {count} - 1);\n
form declare_fixed_predicates =         variable indexed, one, good : boolean;\n
form declare_file count =         variable v : cycle_words(0 to {count} - 1);\n
form declare_signs count =         variable g : cycle_words(0 to {count} - 1);\n
form declare_out count =         variable o : cycle_words(0 to {count} - 1);\n
form declare_atoms count =         variable a : cycle_words(0 to {count} - 1);\n
form declare_temporaries count =         variable t : cycle_words(0 to {count} - 1);\n
form declare_wides count =         variable w : cycle_wides(0 to {count} - 1);\n
form declare_fixed_words =         variable zero, thread, threads, word_base, word_stride, sign_base : cycle_word;\n
form declare_fixed_wides =         variable launch, lane_number, record_address, index_address, body_number, bodies, tables : cycle_wide;\n
form declare_members count =         variable member : cycle_wides(0 to {count} - 1);\n

# the lane's opening and close: the steps run inside the loop flow, which a refusal leaves with the refusal's step
# (-1 at the open); the success path returns inside it, and each refusal's stores follow it, one if a refusal
form open_launch =             launch := launch_given;\n            lane_number := lane_given;\n            zero := (others => '0');\n
form launch_load to offset =             {to} := wide_at(memory, launch + {offset});\n
form to_global to =
form shared_open =             -- the operator block's places, not written in VHDL yet\n
form shared_close =
form guarded_load where to address =             if {where} then\n                {to} := word_at(memory, {address});\n            end if;\n
form guarded_widen where to from =             if {where} then\n                {to} := wide_of({from});\n            end if;\n
form open_refused_unless where =             if not {where} then\n                refusal := -1;\n                exit flow;\n            end if;\n
form refuse where at =             if {where} then\n                refusal := {at};\n                exit flow;\n            end if;\n
form label_refused_open =         end loop flow;\n        if refusal = -1 then\n
form label_refused at =         end if;\n        if refusal = {at} then\n
form count_add address =             put_word(memory, {address}, word_at(memory, {address}) + 1);\n
form return =             return;\n
form step_note at operation =             -- step {at}, operation {operation}\n

# carry chains through a register's limbs: alone for a register of one limb, else first, middle and last; the carry is
# a variable each link sets and the next reads, as PTX's carry flag
form add_alone to left right =             {to} := word_of({left}) + word_of({right});\n
form add_first to left right =             total := resize(word_of({left}), 33) + word_of({right});\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form add_middle to left right =             total := resize(word_of({left}), 33) + word_of({right}) + carry;\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form add_last to left right =             {to} := word_of({left}) + word_of({right}) + carry;\n
form subtract_alone to left right =             {to} := word_of({left}) - word_of({right});\n
form subtract_first to left right =             total := resize(word_of({left}), 33) - word_of({right});\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form subtract_middle to left right =             total := resize(word_of({left}), 33) - word_of({right}) - carry;\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form subtract_last to left right =             {to} := word_of({left}) - word_of({right}) - carry;\n
# the subtract chain whose top limb leaves its borrow for borrow_read
form borrow_alone to left right =             total := resize(word_of({left}), 33) - word_of({right});\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form borrow_first to left right =             total := resize(word_of({left}), 33) - word_of({right});\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form borrow_middle to left right =             total := resize(word_of({left}), 33) - word_of({right}) - carry;\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form borrow_last to left right =             total := resize(word_of({left}), 33) - word_of({right}) - carry;\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form borrow_read held where =             {held} := word_of(0) - carry;\n            {where} := carry /= 0;\n

# a word's arithmetic
form word_copy to from =             {to} := word_of({from});\n
form word_set to value =             {to} := word_of({value});\n
form word_and to left right =             {to} := word_of({left}) and word_of({right});\n
form word_or to left right =             {to} := word_of({left}) or word_of({right});\n
form word_xor to left right =             {to} := word_of({left}) xor word_of({right});\n
form word_shift_left to from bits =             {to} := shift_left(word_of({from}), {bits});\n
form word_shift_right to from bits =             {to} := shift_right(word_of({from}), {bits});\n
form word_funnel_right to low high bits =             {to} := resize(shift_right(word_of({high}) & word_of({low}), {bits}), 32);\n
form word_multiply to left right =             {to} := resize(word_of({left}) * word_of({right}), 32);\n
form word_multiply_add to left right added =             {to} := resize(word_of({left}) * word_of({right}) + word_of({added}), 32);\n
form word_divide to left right =             {to} := word_of({left}) / word_of({right});\n
form word_select to chosen otherwise where =             if {where} then\n                {to} := word_of({chosen});\n            else\n                {to} := word_of({otherwise});\n            end if;\n
form product_low to left right added =             product := word_of({left}) * word_of({right});\n            total := resize(product(31 downto 0), 33) + word_of({added});\n            {to} := total(31 downto 0);\n            carry := to_integer(total(32 downto 32));\n
form product_high to left right =             product := word_of({left}) * word_of({right});\n            {to} := product(63 downto 32) + carry;\n

# a sign's arithmetic, a signed word of -1, 0 or 1
form sign_set to value =             {to} := word_of({value});\n
form sign_select to chosen otherwise where =             if {where} then\n                {to} := word_of({chosen});\n            else\n                {to} := word_of({otherwise});\n            end if;\n
form sign_multiply to left right =             {to} := word_of(signed_of(word_of({left})) * signed_of(word_of({right})));\n
form sign_absolute to from =             {to} := word_of(abs(signed_of(word_of({from}))));\n
form sign_negate to from =             {to} := word_of(-signed_of(word_of({from})));\n

# tests, each setting a predicate
form test_nonzero where value =             {where} := word_of({value}) /= 0;\n
form test_zero where value =             {where} := word_of({value}) = 0;\n
form test_negative where value =             {where} := signed_of(word_of({value})) < 0;\n
form test_signed_zero where value =             {where} := signed_of(word_of({value})) = 0;\n
form test_signed_differ where left right =             {where} := signed_of(word_of({left})) /= signed_of(word_of({right}));\n
form test_signed_greater where left right =             {where} := signed_of(word_of({left})) > signed_of(word_of({right}));\n
form test_wide_nonzero where value =             {where} := wide_of({value}) /= 0;\n
form test_wide_equal where left right =             {where} := wide_of({left}) = wide_of({right});\n
form test_wide_below where left right =             {where} := wide_of({left}) < wide_of({right});\n
form test_wide_below_and where left right also =             {where} := (wide_of({left}) < wide_of({right})) and {also};\n
form predicate_xor where left right =             {where} := {left} xor {right};\n
form predicate_and where left right =             {where} := {left} and {right};\n

# 64-bit words: addresses, the lane's number and a division's parts
form wide_from_word to from =             {to} := wide_of({from});\n
form word_from_wide to from =             {to} := word_of({from});\n
form wide_pack to low high =             {to} := word_of({high}) & word_of({low});\n
form wide_unpack low high from =             {low} := {from}(31 downto 0);\n            {high} := {from}(63 downto 32);\n
form wide_multiply to left right =             {to} := resize(wide_of({left}) * wide_of({right}), 64);\n
form wide_multiply_word to left right =             {to} := word_of({left}) * word_of({right});\n
form wide_add to left right =             {to} := wide_of({left}) + wide_of({right});\n
form wide_add_unsigned to left right =             {to} := wide_of({left}) + wide_of({right});\n
form wide_shift_left to from bits =             {to} := shift_left(wide_of({from}), {bits});\n
form wide_select to chosen otherwise where =             if {where} then\n                {to} := wide_of({chosen});\n            else\n                {to} := wide_of({otherwise});\n            end if;\n
form wide_divide to left right =             {to} := wide_of({left}) / wide_of({right});\n

# memory: the members' and the tables' words and the record's words; shared memory is the operator block's, which is
# not written in VHDL yet
form global_load to address offset =             {to} := word_at(memory, {address} + {offset});\n
form record_store offset from =             put_word(memory, record_address + {offset}, word_of({from}));\n
form shared_store address from =             -- shared store\n
form shared_store_byte address from =             -- shared store\n
form shared_load to address =             -- shared load\n
form shared_load_signed_byte to address =             -- shared load\n

# a call into the operator block, which is not written in VHDL yet: the lane stops there
form call_open =             assert false report "cycle: a step that calls the operator block is not held in VHDL" severity failure;\n
form call_argument at value =             -- argument {at}: {value}\n
form call_answer_declare =
form call_answered function =             -- call {function} (
form call function =             -- call {function} (
form call_parameter_first at = {at}
form call_parameter_next at = , {at}
form call_parameters_close = )\n
form answer_load to =             -- answer to {to}\n
form call_close =

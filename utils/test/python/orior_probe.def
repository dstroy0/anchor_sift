;
; The entries utils/test/python/sift_test.py reads from the orior kernel built alone as a Windows DLL, with
; ORIOR_COUNT_READS=1 so the read counters exist. A shared object on Linux exports them without this file.
LIBRARY orior_host
EXPORTS
    orior_naive
    orior_inorder
    orior_free
    orior_run
    orior_choose
    orior_engine_name
    orior_anchors_for
    orior_counters_reset
    orior_probes DATA
    orior_verifications DATA
    anchor_field_census
    anchor_steer_magnitude
    anchor_steer_probe_order
    anchor_steer_prefers_free
    anchor_steer_count
    anchor_steer_count_with_probes
    anchor_steer_probe_fits
    anchor_steer_probes_reset
    anchor_steer_probes DATA
